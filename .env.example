# Copy to .env for local runs (never commit real keys)

# OPEN (local Hugging Face model on GPU) or SERVERLESS (NVIDIA Cloud gRPC)
NIM_DEPLOY_MODE=BUNDLED

# Open weights
SVD_OPEN_MODEL_PRESET=videomae-ffc23
SVD_OPEN_MODEL_KIND=videomae
SVD_HF_MODEL_ID=eftt/VideoMae-ffc23-deepfake-detector
SVD_OPEN_PORT=8090
HF_TOKEN=

# Serverless NVCF (when NIM_DEPLOY_MODE=SERVERLESS)
NGC_API_KEY=
NVIDIA_SERVERLESS_GRPC_HOST=grpc.nvcf.nvidia.com
NVIDIA_SERVERLESS_GRPC_PORT=443
SVD_NVIDIA_FUNCTION_ID=847b6e53-0133-452d-ab85-d7acf3ace723

# UI port
APP_PORT=3000
